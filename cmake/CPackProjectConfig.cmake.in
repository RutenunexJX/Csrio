set(_regmap_revision "unknown")
execute_process(
    COMMAND
        "@GIT_EXECUTABLE@" -C "@PROJECT_SOURCE_DIR@"
        rev-parse --short=7 HEAD
    RESULT_VARIABLE _regmap_git_result
    OUTPUT_VARIABLE _regmap_git_output
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
if(_regmap_git_result EQUAL 0 AND NOT _regmap_git_output STREQUAL "")
    set(_regmap_revision "${_regmap_git_output}")
endif()

set(_regmap_source_suffix "-source-unknown")
execute_process(
    COMMAND
        "@GIT_EXECUTABLE@" -C "@PROJECT_SOURCE_DIR@"
        status --porcelain --untracked-files=normal
    RESULT_VARIABLE _regmap_status_result
    OUTPUT_VARIABLE _regmap_status_output
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
if(_regmap_status_result EQUAL 0)
    if(_regmap_status_output STREQUAL "")
        set(_regmap_source_suffix "")
    else()
        set(_regmap_source_suffix "-dirty")
    endif()
endif()
set(
    CPACK_PACKAGE_FILE_NAME
    "Csrio-@PROJECT_VERSION@-@REGMAP_PACKAGE_PLATFORM@-${_regmap_revision}${_regmap_source_suffix}"
)
