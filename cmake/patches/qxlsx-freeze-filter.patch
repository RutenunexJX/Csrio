+/*!
+ * Freeze the first \a rows rows and \a columns columns.
+ */
+void Worksheet::freezePanes(int rows, int columns)
+{
+    Q_D(Worksheet);
+    d->frozenRows = qMax(0, qMin(rows, XLSX_ROW_MAX - 1));
+    d->frozenColumns = qMax(0, qMin(columns, XLSX_COLUMN_MAX - 1));
+}
+
+int Worksheet::frozenRowCount() const
+{
+    Q_D(const Worksheet);
+    return d->frozenRows;
+}
+
+int Worksheet::frozenColumnCount() const
+{
+    Q_D(const Worksheet);
+    return d->frozenColumns;
+}
+
+/*!
+ * Enable an auto filter for \a range.
+ */
+bool Worksheet::setAutoFilter(const CellRange &range)
+{
+    Q_D(Worksheet);
+    if (!range.isValid()) {
+        d->autoFilterRange = CellRange();
+        return false;
+    }
+    d->autoFilterRange = range;
+    return true;
+}
+
+CellRange Worksheet::autoFilter() const
+{
+    Q_D(const Worksheet);
+    return d->autoFilterRange;
+}
