+void WorksheetPrivate::loadXmlSheetProperties(QXmlStreamReader &reader)
+{
+    Q_ASSERT(reader.name() == QLatin1String("sheetPr"));
+
+    while (!reader.atEnd() && !(reader.name() == QLatin1String("sheetPr") &&
+                                reader.tokenType() == QXmlStreamReader::EndElement)) {
+        reader.readNextStartElement();
+        if (reader.tokenType() == QXmlStreamReader::StartElement &&
+            reader.name() == QLatin1String("outlinePr")) {
+            summaryRowsBelow =
+                reader.attributes().value(QLatin1String("summaryBelow")) != QLatin1String("0");
+        }
+    }
+}
