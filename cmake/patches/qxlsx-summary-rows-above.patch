+/*!
+ * Insert an \a image between zero-based cell markers.
+ *
+ * A two-cell anchor moves and sizes with its cells, so images inside grouped
+ * rows collapse and expand with those rows.
+ */
+int Worksheet::insertImage(
+    int fromRow,
+    int fromColumn,
+    int toRow,
+    int toColumn,
+    const QImage &image)
+{
+    Q_D(Worksheet);
+
+    if (image.isNull() || fromRow < 0 || fromColumn < 0 || toRow <= fromRow
+        || toColumn <= fromColumn) {
+        return 0;
+    }
+
+    if (!d->drawing) {
+        d->drawing = std::make_shared<Drawing>(this, F_NewFromScratch);
+    }
+
+    auto anchor = new DrawingTwoCellAnchor(d->drawing.get(), DrawingAnchor::Picture);
+    anchor->from = XlsxMarker(fromRow, fromColumn, 0, 0);
+    anchor->to = XlsxMarker(toRow, toColumn, 0, 0);
+    anchor->setObjectPicture(image);
+    return anchor->getm_id();
+}
