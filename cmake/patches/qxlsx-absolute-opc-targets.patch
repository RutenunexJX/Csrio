+QString resolveRelationshipTarget(const QString &sourcePart, const QString &target)
+{
+    if (target.startsWith(u'/'))
+        return QDir::cleanPath(target.mid(1));
+    if (sourcePart.isEmpty())
+        return QDir::cleanPath(target);
+
+    const auto parts = splitPath(sourcePart);
+    if (parts.first() == QLatin1String("."))
+        return QDir::cleanPath(target);
+
+    return QDir::cleanPath(parts.first() + u'/' + target);
+}
